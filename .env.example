# Telegram API credentials (получить на https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here
PHONE_NUMBER=+1234567890

# ID пользователя для уведомлений (опционально)
# Чтобы получить свой ID, напишите боту @userinfobot
NOTIFICATION_USER_ID=0

# Сообщение автоответа вне рабочего времени
AUTO_REPLY_MESSAGE=🌙 Спасибо за ваше сообщение!\n\nСейчас нерабочее время или выходной день.\nРабочие часы:\n• Пн-Чт: 9:00 - 17:30\n• Пт: 9:00 - 17:00\n• Сб-Вс: выходные\n\nЯ отвечу вам в ближайшее рабочее время.
